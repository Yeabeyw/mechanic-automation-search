rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.roles.hasAny(['admin']);
    }

    function isSecurityAdmin() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.roles.hasAny(['security_admin']);
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validNewUserProfile() {
      return request.resource.data.keys().hasOnly([
          'full_name', 'email', 'roles', 'created_at', 'consent'
        ])
        && request.resource.data.keys().hasAll([
          'full_name', 'email', 'roles', 'created_at', 'consent'
        ])
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.roles == ['customer']
        && request.resource.data.created_at == request.time
        && request.resource.data.consent is map
        && request.resource.data.consent.keys().hasOnly([
          'accepted', 'accepted_at', 'policy_version'
        ])
        && request.resource.data.consent.keys().hasAll([
          'accepted', 'accepted_at', 'policy_version'
        ])
        && request.resource.data.consent.accepted == true
        && request.resource.data.consent.accepted_at == request.time
        && request.resource.data.consent.policy_version == 'privacy-2026-03';
    }

    function ownsMechanic(mechanicId) {
      let ownerPath = /databases/$(database)/documents/mechanic_owners/$(mechanicId);
      return isSignedIn()
        && exists(ownerPath)
        && get(ownerPath).data.user_id == request.auth.uid;
    }

    function isAssignedMechanicAfterAcceptance(requestId) {
      let requestPath = /databases/$(database)/documents/service_requests/$(requestId);
      return isSignedIn()
        && exists(requestPath)
        && isVerifiedAcceptedAssignment(requestId);
    }

    function isVerifiedAcceptedAssignment(requestId) {
      let requestPath = /databases/$(database)/documents/service_requests/$(requestId);
      let mechanicId = get(requestPath).data.mechanic_id;
      let mechanicPath = /databases/$(database)/documents/mechanics/$(mechanicId);
      return get(requestPath).data.mechanic_owner_id == request.auth.uid
        && get(requestPath).data.status in ['accepted', 'in_progress', 'completed']
        && exists(mechanicPath)
        && get(mechanicPath).data.verified == true
        && get(mechanicPath).data.status != 'suspended'
        && ownsMechanic(mechanicId);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isOwner(userId) && validNewUserProfile();
      allow update: if false;
      allow delete: if false;
    }

    match /mechanics/{mechanicId} {
      allow get: if isAdmin()
        || ownsMechanic(mechanicId)
        || resource.data.verified == true;
      allow list: if isAdmin()
        || ownsMechanic(mechanicId)
        || resource.data.verified == true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /mechanic_owners/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /service_requests/{requestId} {
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.customer_id == request.auth.uid);
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.customer_id == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /service_request_private/{requestId} {
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.customer_id == request.auth.uid)
        || isAssignedMechanicAfterAcceptance(requestId);
      allow list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /mechanic_private/{mechanicId} {
      allow get: if isAdmin() || ownsMechanic(mechanicId);
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /ledger_blocks/{blockId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /ledger_secrets/{secretId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /ledger_state/{stateId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /security_audit/{auditId} {
      allow get: if isSecurityAdmin();
      allow list: if isSecurityAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /ai_dataset/{docId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /ai_models/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow get, list, create, update, delete: if false;
    }
  }
}
