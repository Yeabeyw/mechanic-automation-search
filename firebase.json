{
    "firestore":  {
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json"
                  },
    "functions":  {
                      "source":  "functions",
                      "runtime":  "nodejs22"
                  },
    "hosting":  [
                    {
                        "target":  "main",
                        "public":  ".output/public",
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*",
                                       "**/node_modules/**"
                                   ],
                        "rewrites":  [
                                         {
                                             "source":  "**",
                                             "destination":  "/_shell.html"
                                         }
                                     ]
                    },
                    {
                        "target":  "security",
                        "public":  "security-console/dist",
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*",
                                       "**/node_modules/**"
                                   ],
                        "rewrites":  [
                                         {
                                             "source":  "**",
                                             "destination":  "/index.html"
                                         }
                                     ]
                    }
                ]
}
