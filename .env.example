# Firebase client configuration for the AutoHelp Lesotho Android app.
# Get these values from your Firebase project configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Set to true only after deploying the secure Firebase Cloud Functions backend.
VITE_FIREBASE_MUTATIONS_ENABLED=false
